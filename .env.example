# ─── Servidor ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Origen(es) del frontend permitido(s) por CORS (separar con comas)
CORS_ORIGIN=http://localhost:3000

# ─── Base de datos ───────────────────────────────────────────
# Dialecto: "mysql" (local) o "postgres" (Supabase y otros Postgres).
# Si usás DATABASE_URL con esquema postgres:// se detecta solo.
DB_DIALECT=mysql

# Opción A — Campos sueltos (desarrollo local con MySQL):
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=frantoken
DB_USER=root
DB_PASSWORD=

# Opción B — Cadena de conexión única (producción / hostings). Tiene prioridad.
# Supabase (Session Pooler, recomendado): Project Settings > Database > Connection string.
#   DATABASE_URL=postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Railway/Aiven MySQL:
#   DATABASE_URL=mysql://user:pass@host:3306/dbname
DATABASE_URL=

# SSL requerido por casi todos los hosts administrados (Supabase incluido).
DB_SSL=false

# Sincroniza modelos -> tablas al arrancar (crea las tablas). Útil en el primer
# deploy; en producción estable preferir migraciones.
DB_SYNC=true
# Siembra datos demo al arrancar si faltan (proyectos + usuario demo + circuito).
# Útil en hosts sin "run command" (p. ej. Render free). Idempotente; apagar luego.
SEED_ON_BOOT=false
# Pone SQL en consola.
DB_LOGGING=false

# ─── Autenticación ───────────────────────────────────────────
# Cambiar OBLIGATORIAMENTE en cualquier entorno real.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=7d
# Rondas de bcrypt para el hash de contraseñas.
BCRYPT_ROUNDS=10

# ─── Blockchain (contratos ERC-3643 del repo FranToken) ──────
# Lecturas on-chain. Si es false, /api/blockchain responde 503.
BLOCKCHAIN_ENABLED=false
# Habilita operaciones de agente (mint, KYC, distribución, congelar, pausar).
# Requiere además rol admin y una clave de agente. Dejar en false salvo uso real.
BLOCKCHAIN_ALLOW_WRITES=false
# RPC del nodo (Hardhat local: http://127.0.0.1:8545; o Sepolia/Infura/Alchemy).
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# ID de cadena (opcional; 31337 = Hardhat, 11155111 = Sepolia).
BLOCKCHAIN_CHAIN_ID=
# Clave privada del agente/firmante del servidor (SOLO para escrituras).
# Nunca commitear una clave real. En Hardhat local, usar una cuenta de prueba.
BLOCKCHAIN_AGENT_PRIVATE_KEY=
# Direcciones desplegadas (salida de scripts/deploy.js del repo FranToken).
FRANCHISE_TOKEN_ADDRESS=
IDENTITY_REGISTRY_ADDRESS=
FRANCHISE_COMPLIANCE_ADDRESS=
PAYMENT_TOKEN_ADDRESS=
# C4 — InvestmentAgreement (emisión mediante compra conciliada). Para que la
# API emita por C4, el firmante del servidor debe ser su paymentVerifier y el
# token debe tener a este contrato como issuanceController.
INVESTMENT_AGREEMENT_ADDRESS=

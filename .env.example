# ─── Servidor ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Origen(es) del frontend permitido(s) por CORS (separar con comas)
CORS_ORIGIN=http://localhost:3000

# ─── Base de datos ───────────────────────────────────────────
# Dialecto: "mysql" (local) o "postgres" (Supabase y otros Postgres).
# Si usás DATABASE_URL con esquema postgres:// se detecta solo.
DB_DIALECT=mysql

# Opción A — Campos sueltos (desarrollo local con MySQL):
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=frantoken
DB_USER=root
DB_PASSWORD=

# Opción B — Cadena de conexión única (producción / hostings). Tiene prioridad.
# Supabase (Session Pooler, recomendado): Project Settings > Database > Connection string.
#   DATABASE_URL=postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Railway/Aiven MySQL:
#   DATABASE_URL=mysql://user:pass@host:3306/dbname
DATABASE_URL=

# SSL requerido por casi todos los hosts administrados (Supabase incluido).
DB_SSL=false

# Sincroniza modelos -> tablas al arrancar (crea las tablas). Útil en el primer
# deploy nuevo. Para bases existentes usar npm run db:migrate:mvp.
DB_SYNC=false
# Siembra datos demo al arrancar si faltan (metadatos de proyectos + usuario demo; sin compras ni repartos).
# Útil en hosts sin "run command" (p. ej. Render free). Idempotente; apagar luego.
SEED_ON_BOOT=false
# Pone SQL en consola.
DB_LOGGING=false

# ─── Autenticación ───────────────────────────────────────────
# Cambiar OBLIGATORIAMENTE en cualquier entorno real.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=7d
# Rondas de bcrypt para el hash de contraseñas.
BCRYPT_ROUNDS=10

# ─── MVP académico: Hardhat local 31337 ─────────────────────
# Para ejecutar el recorrido completo, habilitar ambos en el .env local.
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_ALLOW_WRITES=false
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337
# Generado con npm run deploy:academic en el repositorio blockchain hermano.
BLOCKCHAIN_MANIFEST_PATH=../FranToken_Blockchain/deployments/academic-local.json
# Solo para el nodo LOCAL desechable, permite cuentas desbloqueadas del manifiesto.
BLOCKCHAIN_USE_LOCAL_ACCOUNTS=false
# Alternativa: claves distintas de administrador y verificador (solo servidor).
# Dejar vacías al usar cuentas locales. Nunca copiarlas al frontend o Git.
BLOCKCHAIN_ADMIN_PRIVATE_KEY=
BLOCKCHAIN_VERIFIER_PRIVATE_KEY=
# Configuración antigua, exclusivamente para lecturas /api/blockchain.
BLOCKCHAIN_AGENT_PRIVATE_KEY=
FRANCHISE_TOKEN_ADDRESS=
IDENTITY_REGISTRY_ADDRESS=
FRANCHISE_COMPLIANCE_ADDRESS=
PAYMENT_TOKEN_ADDRESS=
INVESTMENT_AGREEMENT_ADDRESS=

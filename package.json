{
  "name": "frantoken-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend prototipo para FranToken: API REST que reemplaza los repositorios demo del frontend (sesión, cuenta, marketplace).",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:setup": "node scripts/local-db.cjs setup",
    "db:start": "node scripts/local-db.cjs start",
    "db:stop": "node scripts/local-db.cjs stop",
    "db:status": "node scripts/local-db.cjs status",
    "db:seed": "ts-node-dev --transpile-only src/seeders/seed.ts",
    "db:seed:prod": "node dist/seeders/seed.js",
    "typecheck": "tsc --noEmit",
    "db:migrate:mvp": "ts-node --project tsconfig.scripts.json scripts/migrate-mvp.ts",
    "db:migrate:franchises": "ts-node --project tsconfig.scripts.json scripts/migrate-franchise-management.ts",
    "superadmin:create": "ts-node --project tsconfig.scripts.json scripts/create-superadmin.ts",
    "mvp:import": "ts-node --project tsconfig.scripts.json scripts/import-academic.ts",
    "test:mvp": "node test/integrated-mvp.cjs",
    "mvp:sync-artifact": "node scripts/sync-academic-artifact.cjs",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.4",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.11.5",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.17.10",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  }
}
